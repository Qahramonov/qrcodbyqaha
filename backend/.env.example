# ================================================================
#  Chat helper — configuration. Copy to .env:  cp .env.example .env
#  NEVER commit .env, never put the token into the Android app.
# ================================================================

# --- Telegram (required) -------------------------------------------------
# Token from @BotFather. Enable: Bot Settings → Business Mode → ON
BOT_TOKEN=
# Main administrator (Telegram user ID is the identity, username is informational)
SUPER_ADMIN_ID=8053614984
OWNER_USERNAME=libPM
POLLING_TIMEOUT=30

# --- General ------------------------------------------------------------------
DEFAULT_LANG=ru
COMMAND_PREFIX=.
TIMEZONE=Asia/Tashkent
LOG_LEVEL=INFO
# DATA_DIR=data            # database, logs, backups, temp files (relative to backend/)

# --- Local API for Chat helper Control (Android) --------------------------
API_ENABLED=true
API_HOST=127.0.0.1          # keep localhost when the APK runs on the same phone
API_PORT=8787
# Remote control from another device (optional, see docs/SECURITY.md):
API_REMOTE_ENABLED=false
# Swagger UI at /api/docs lists every route; keep it off on the phone (development only):
API_DOCS_ENABLED=false
API_SSL_CERTFILE=
API_SSL_KEYFILE=
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000
PAIRING_CODE_TTL=300

# --- AI providers (all optional; non-AI features work without keys) -------
AI_DEFAULT_PROVIDER=auto    # auto | openai | gemini | anthropic | compatible
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Any OpenAI-compatible endpoint (OpenRouter, Groq, DeepSeek, local Ollama…)
COMPAT_NAME=compatible
COMPAT_API_KEY=
COMPAT_BASE_URL=
COMPAT_MODEL=
AI_TIMEOUT=60
AI_MAX_CONCURRENCY=3
AI_GLOBAL_DAILY_BUDGET_USD=2.0
AI_USER_DAILY_BUDGET_USD=0.25

# --- Media Studio ---------------------------------------------------------------
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
MEDIA_MAX_INPUT_MB=20       # Bot API download limit is 20 MB
MEDIA_MAX_DURATION=180
MEDIA_MAX_REVERSE_VIDEO=60
MEDIA_TIMEOUT=120
MEDIA_CONCURRENCY=1         # 1 is best for phones
MEDIA_FONT=                 # optional .ttf for memes (default: bundled Oswald)

# --- Privacy / retention / backups -----------------------------------------
HISTORY_RETENTION_DAYS=7
LOG_RETENTION_DAYS=30
BACKUP_KEEP=7
BACKUP_INTERVAL_HOURS=24

# --- Payments: Telegram Stars (XTR). Keep false until you configure plans --
PAYMENTS_ENABLED=false
